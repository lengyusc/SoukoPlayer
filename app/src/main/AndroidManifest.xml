<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/souko_player"
        android:label="@string/app_name"
        android:roundIcon="@drawable/souko_player"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoukoPlayer"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 主页面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SoukoPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Settings"
            android:theme="@style/Theme.SoukoPlayer" />

        <!-- 搜索 -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:label="search"
            android:theme="@style/Theme.SoukoPlayer" />

        <!-- 添加音频服务 -->
        <service
            android:name=".AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true"
            android:stopWithTask="true"
            tools:ignore="ForegroundServicePermission" />

        <!-- 清除缓存 -->
        <receiver
            android:name=".CacheClearReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="CLEAR_GLIDE_CACHE" />
                <action android:name="CLEAR_ALL_CACHES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>