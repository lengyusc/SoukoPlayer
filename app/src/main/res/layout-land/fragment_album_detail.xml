<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 主要内容区域 -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FDFFFFFF">

        <!-- 顶部工具栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F38A21"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@android:drawable/ic_menu_revert"/>

            <TextView
                android:id="@+id/tvAlbumTitleTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专辑详情"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"/>
        </RelativeLayout>

        <!-- 上半部分：专辑信息 + 曲目列表 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">

            <!-- 左侧专辑信息 -->
            <LinearLayout
                android:id="@+id/albumInfoLayout"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="top"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <ImageView
                    android:id="@+id/ivAlbumArt"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/souko_player"
                    android:background="@color/white"
                    android:layout_gravity="start"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tvAlbumTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="专辑标题"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="歌手名"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvReleaseYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发行年份"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- 右侧曲目列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTracks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 注意：原本这里的 custom_player_controls include 已移除 -->

    <!-- 全屏专辑封面（带模糊背景效果）- 放在最外层，覆盖整个界面 -->
    <FrameLayout
        android:id="@+id/fullScreenAlbumContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 专辑封面（居中显示，限制最大尺寸） -->
        <ImageView
            android:id="@+id/ivFullScreenAlbumArt"
            android:layout_width="500dp"
            android:layout_height="500dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop" />

    </FrameLayout>
</FrameLayout>